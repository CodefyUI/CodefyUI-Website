---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { en } from '../i18n/en';
import { zh } from '../i18n/zh';
const t = en;
---

<Base t={t} title={`${t.notFound.title} — CodefyUI`} path="/404" noindex>
  <Nav t={t} />
  <main id="main" class="nf">
    <div class="wrap nf__inner">
      <div class="nf__wire" aria-hidden="true">
        <span class="nf__port"></span><span class="nf__line"></span><span class="nf__port nf__port--empty"></span>
      </div>
      <h1 class="nf__title">404</h1>
      <p class="lead">{t.notFound.body}</p>
      <p class="lead" lang="zh-Hant-TW">{zh.notFound.body}</p>
      <div class="nf__actions">
        <a class="btn btn--primary" href="/">{t.notFound.home}</a>
        <a class="btn btn--ghost" href="/zh-TW/" lang="zh-Hant-TW">{zh.notFound.home}</a>
      </div>
    </div>
  </main>
</Base>

<script>
  import '../scripts/site';
</script>

<style>
  .nf {
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding: 120px 0 80px;
    background-image: radial-gradient(circle at 1px 1px, #2a323e 1px, transparent 0);
    background-size: 24px 24px;
  }
  .nf__title {
    font-size: clamp(6rem, 22vw, 18rem);
    line-height: 0.85;
    letter-spacing: -0.06em;
    margin: 24px 0 32px;
  }
  .nf .lead {
    margin: 0 0 8px;
  }
  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .nf__wire {
    display: flex;
    align-items: center;
    max-width: 420px;
  }
  .nf__port {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--tensor);
    flex: none;
  }
  .nf__port--empty {
    background: none;
    box-shadow: inset 0 0 0 2px var(--coral);
  }
  .nf__line {
    flex: 1;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--tensor) 0 10px, transparent 10px 18px);
    mask-image: linear-gradient(90deg, #000 40%, transparent);
  }
</style>
