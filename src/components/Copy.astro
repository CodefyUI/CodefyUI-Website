---
interface Props {
  text: string;
  label: string;
  done: string;
  ps?: boolean;
  paper?: boolean;
}
const { text, label, done, ps = false, paper = false } = Astro.props;
---

<div class:list={['cmd', ps && 'cmd--ps', paper && 'cmd--paper']}>
  <code class="cmd__text">{text}</code>
  <button type="button" class="copy" data-copy={text} data-label={label} data-done={done}>
    <svg viewBox="0 0 16 16" aria-hidden="true"
      ><rect x="5" y="5" width="9" height="9" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"></rect><path
        d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"></path></svg
    >
    <span>{label}</span>
  </button>
</div>
