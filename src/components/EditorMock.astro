---
// A vector recreation of the CodefyUI editor for the four-step tour. Every
// element is HTML or SVG, so the camera can zoom in without blurring.
import { nodes, edges, edgePath, nodeHeight, TYPE_COLOR, digit } from '../data/mock-graph';

interface Props {
  label: string;
}
const { label } = Astro.props;

const lib = [
  { cat: 'Control', color: '#22c55e', count: 1, items: [['Start', 'Entry point; the node its trigger reaches runs first']] },
  {
    cat: 'Data',
    color: '#00bcd4',
    count: 27,
    items: [
      ['Dataset', 'Load a vision dataset such as MNIST or CIFAR10'],
      ['DataLoader', 'Split a dataset into batches for training'],
    ],
  },
  {
    cat: 'Training',
    color: '#f66358',
    count: 7,
    items: [
      ['Optimizer', 'Turn gradients into weight updates: 9 algorithms'],
      ['Loss', 'Cross-entropy, MSE, BCE and eight more losses'],
      ['TrainingLoop', 'Train a model for n epochs; outputs model and losses'],
      ['EvaluateModel', 'Classifier accuracy on a dataset, with correct/total'],
    ],
  },
];

const px = digit();
const lossPts = [2.3, 1.1, 0.62, 0.41, 0.33, 0.27, 0.22, 0.2, 0.17, 0.15, 0.14, 0.12, 0.11, 0.1, 0.09, 0.085, 0.08, 0.075, 0.07, 0.066];
const line = (w: number, h: number, pad = 4) =>
  lossPts
    .map((v, i) => `${(pad + (i / (lossPts.length - 1)) * (w - 2 * pad)).toFixed(1)},${(pad + (1 - v / 2.4) * (h - 2 * pad)).toFixed(1)}`)
    .join(' ');
const heat = (v: number) => {
  const a = Math.max(0, Math.min(1, (v + 0.4242) / 3.2457));
  return a < 0.02 ? '#121821' : `color-mix(in oklab, #22d3ee ${Math.round(12 + a * 88)}%, #121821)`;
};
---

<div class="mock" data-mock role="img" aria-label={label}>
  <div class="mock__stage" data-stage>
    <div class="mock__cam" data-cam>
      <!-- toolbar -->
      <div class="m-bar">
        <span class="m-logo">Codefy<b>UI</b></span>
        <span class="m-btn m-run" data-m="run">
          <svg viewBox="0 0 12 12"><path d="M3 1.8v8.4L10 6z" fill="currentColor"></path></svg>Run
        </span>
        <span class="m-btn m-ghost">■ Stop</span>
        <span class="m-select" data-m="device">Follow Settings (CPU)</span>
        <span class="m-sep"></span>
        <span class="m-menu">File</span><span class="m-menu">Export</span><span class="m-sep"></span>
        <span class="m-menu">Templates</span><span class="m-menu">Reload Nodes</span><span class="m-menu">Custom Nodes</span>
        <span class="m-select m-auto">Auto Layout</span>
        <span class="m-status" data-m="status"><i></i><span>Idle</span></span>
        <span class="m-right"><span class="m-icon">?</span><span class="m-icon">Aa</span><span class="m-icon">EN</span></span>
      </div>
      <div class="m-tabs"><span class="m-tab">Train CNN on MNIST <i>×</i></span><span class="m-plus">+</span></div>

      <!-- rail + library -->
      <div class="m-rail">
        <span class="is-on"></span><span></span><span></span><span></span><span></span>
      </div>
      <div class="m-lib">
        <div class="m-lib__title">NODES</div>
        <div class="m-search">Search nodes...</div>
        {
          lib.map((g) => (
            <div class="m-cat">
              <div class="m-cat__head" style={`--c:${g.color}`}>
                <i />
                {g.cat}
                <small>{g.count}</small>
              </div>
              {g.items.map(([n, d]) => (
                <div class="m-item" data-lib={n}>
                  <b>{n}</b>
                  <span>{d}</span>
                </div>
              ))}
            </div>
          ))
        }
      </div>

      <!-- canvas -->
      <div class="m-canvas" data-canvas>
        <svg class="m-wires" viewBox="0 0 1000 576" width="1000" height="576">
          {
            edges.map((e) => (
              <path
                d={edgePath(e)}
                data-edge={e.id}
                class:list={['m-wire', e.type === 'trigger' && 'm-wire--trigger']}
                style={`stroke:${TYPE_COLOR[e.type]}`}
                pathLength="1"
              />
            ))
          }
          <path data-m="badwire" class="m-wire m-wire--bad" d="" />
          <path data-m="livewire" class="m-wire" d="" style={`stroke:${TYPE_COLOR.OPTIMIZER}`} />
        </svg>
        {
          nodes.map((n) => (
            <div
              class="m-node"
              data-node={n.id}
              style={`left:${n.x}px;top:${n.y}px;width:${n.w}px;height:${nodeHeight(n)}px;--cat:${n.color}`}
            >
              <div class="m-node__head">
                <b>{n.name}</b>
                <span>{n.cat}</span>
              </div>
              {n.inputs.map((p) => (
                <div class="m-port m-port--in" style={`--pc:${TYPE_COLOR[p.type]}`} data-port={`${n.id}:${p.name}:in`}>
                  <i class:list={[p.type === 'trigger' && 'is-diamond']} />
                  {p.name}
                </div>
              ))}
              {n.outputs.map((p) => (
                <div class="m-port m-port--out" style={`--pc:${TYPE_COLOR[p.type]}`} data-port={`${n.id}:${p.name}:out`}>
                  {p.name}
                  <i class:list={[p.type === 'trigger' && 'is-diamond']} />
                </div>
              ))}
              {n.params.length > 0 && (
                <div class="m-params">
                  {n.params.map(([k, v]) => (
                    <div>
                      <span>{k}</span>
                      <code>{v}</code>
                    </div>
                  ))}
                </div>
              )}
              {n.extra === 'chart' && (
                <svg class="m-chart" viewBox="0 0 140 66" data-m="vizchart">
                  <polyline points={line(140, 66)} pathLength="1" />
                </svg>
              )}
              {n.extra === 'result' && (
                <div class="m-result" data-m="result">
                  <span>value</span>
                  <code>—</code>
                </div>
              )}
              {n.id === 'train' && <div class="m-progress" data-m="progress" />}
            </div>
          ))
        }
        <div class="m-tip" data-m="tip">optimizer → dataloader: types differ</div>
      </div>

      <!-- inspector -->
      <div class="m-insp" data-m="insp">
        <div class="m-insp__head">Inspector</div>
        <div class="m-insp__title"><i></i>DataLoader <small>dataloader → images</small></div>
        <div class="m-insp__meta"><span>shape</span><code>[64, 1, 28, 28]</code></div>
        <div class="m-insp__img">
          {px.map((v) => <span style={`background:${heat(v)}`} />)}
        </div>
        <div class="m-insp__stats">
          <span>min <b>-0.4242</b></span><span>max <b>2.8215</b></span>
        </div>
        <div class="m-insp__meta"><span>labels</span><code>[7, 2, 1, 0, 4, 1, 4, 9, …]</code></div>
        <div class="m-insp__tabs"><span class="is-on">Output</span><span>Steps</span><span>Backward</span></div>
      </div>

      <!-- results panel -->
      <div class="m-results">
        <div class="m-results__tabs">
          <span class="is-on" data-m="tab-log">EXECUTION LOG</span><span data-m="tab-train">TRAINING</span><span>RUNS</span>
        </div>
        <div class="m-log" data-m="log"></div>
        <svg class="m-loss" viewBox="0 0 980 112" data-m="loss" preserveAspectRatio="none">
          <g class="m-loss__grid">
            <line x1="0" y1="28" x2="980" y2="28"></line><line x1="0" y1="56" x2="980" y2="56"></line><line x1="0" y1="84" x2="980" y2="84"></line>
          </g>
          <polyline points={line(980, 112, 8)} pathLength="1"></polyline>
        </svg>
      </div>

      <!-- pointer -->
      <div class="m-ghost" data-m="ghost"><b>Optimizer</b><span>Training</span></div>
      <svg class="m-cursor" data-m="cursor" viewBox="0 0 20 24" width="20" height="24">
        <path d="M2 2l15 9.5-6.6 1.4L7 20.5z" fill="#f0f4f8" stroke="#0f1319" stroke-width="1.4" stroke-linejoin="round"></path>
      </svg>
    </div>
  </div>
</div>
