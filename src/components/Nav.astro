---
import type { Dict } from '../i18n/en';
import { stars } from '../data/release';
interface Props {
  t: Dict;
}
const { t } = Astro.props;
const starCount = await stars();
const zh = t.lang !== 'en';
const home = zh ? '/zh-TW/' : '/';
const other = zh ? '/' : '/zh-TW/';
const docs = zh ? 'https://docs.codefyui.com/zh-TW/' : 'https://docs.codefyui.com/';
const links = [
  { href: '#editor', label: t.nav.editor },
  { href: '#nodes', label: t.nav.nodes },
  { href: '#teaching', label: t.nav.teaching },
  { href: '#ship', label: t.nav.ship },
  { href: '#install', label: t.nav.install },
  { href: docs, label: t.nav.docs },
];
---

<header class="nav" data-nav>
  <div class="wrap nav__inner">
    <a class="wordmark" href={home} aria-label="CodefyUI">
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <path d="M13 9h1.5a2 2 0 0 1 2 2v10a2 2 0 0 0 2 2H19" stroke="#40a445" stroke-width="2" fill="none"></path>
        <rect x="2" y="4" width="11" height="10" rx="2.5" fill="#22d3ee"></rect>
        <rect x="19" y="18" width="11" height="10" rx="2.5" fill="#f0f4f8"></rect>
      </svg>
      <span>Codefy<b>UI</b></span>
    </a>
    <nav aria-label={t.nav.label} id="site-nav">
      <ul class="nav__links">
        {
          links.map((l) => (
            <li>
              <a href={l.href.startsWith('#') ? `${home}${l.href}` : l.href} data-navlink={l.href}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="nav__end">
      <a class="nav__lang" href={other} hreflang={zh ? 'en' : 'zh-TW'} lang={zh ? 'en' : 'zh-Hant-TW'} >{t.nav.switchTo}<span class="sr-only"> — {t.nav.switchLabel}</span></a
      >
      <a class="nav__gh" href="https://github.com/CodefyUI/CodefyUI">
        <svg viewBox="0 0 16 16" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path></svg
        >
        <span class="nav__gh-label">{t.nav.github}</span>
        {starCount ? <span class="nav__stars">{starCount.toLocaleString('en-US')}</span> : null}
      </a>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu>
        <span></span><span></span><span class="sr-only">{t.nav.menu}</span>
      </button>
    </div>
  </div>
</header>
